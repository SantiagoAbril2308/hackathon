# Copia este archivo como .env y llena los valores. NUNCA subas el .env al repositorio.

# TiDB Cloud Serverless (MySQL, TLS obligatorio)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=ruta_serena

# Autenticación de administradores
JWT_SECRET=

# Asistente (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Origen permitido del frontend (ej. http://localhost:5173)
CORS_ORIGIN=

# Scraper y vigencia
SCRAPER_CRON="0 3 * * *"
DIAS_VIGENCIA=30

# Administrador inicial (solo para npm run db:seed)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
